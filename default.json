{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate policy for public repositories. Version updates only: security fixes come from Dependabot security updates, so Renovate's own vulnerability PRs are off.",
  "extends": ["config:best-practices"],
  "timezone": "America/Toronto",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "5 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "osvVulnerabilityAlerts": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Group every patch update into one PR",
      "matchUpdateTypes": ["patch"],
      "groupName": "patch updates",
      "groupSlug": "patch"
    },
    {
      "description": "Group every minor update into one PR, separate from patches",
      "matchUpdateTypes": ["minor"],
      "groupName": "minor updates",
      "groupSlug": "minor"
    },
    {
      "description": "Group GitHub Actions updates together, except majors, which stay one PR per action",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github-actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Label major updates so they can be found with label:dependency/major",
      "matchUpdateTypes": ["major"],
      "addLabels": ["dependency/major"]
    }
  ]
}
